# Rust
/target/

# Installed models (multi-GB; never committed)
/models/
*.rvmp/

# Benchmark and experiment outputs
/scratch/

# Working notes, kept local on purpose.
#
# Handoff docs are written by one session for the next and go stale by design;
# `docs/roadmap.md` is the plan of record and is public. The raw experiment log
# is an internal working record: it argues with itself, withdraws numbers, and
# records reasoning that was later refuted. The public record of what was
# measured is the curated `docs/experiments.md`, and every entry there traces
# back to an entry in the raw log.
/docs/handoff-*.md
/docs/experiments/

# Environment
.env

# Editors / OS
*.swp
.DS_Store

# `nohup bash scripts/<sweep>.sh &` drops this here, and a sweep that greps
# its own tree for provenance would otherwise report itself as dirty.
/nohup.out

# Python bytecode from scripts/
__pycache__/
