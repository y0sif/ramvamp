# Rust
/target/

# Installed models (multi-GB; never committed)
/models/
*.rvmp/

# Benchmark and experiment outputs
/scratch/

# Public docs pages only. docs/roadmap.md is the plan of record; docs/experiments.md is the
# curated record of what was measured, each entry traced to a private raw log.
/docs/*
!/docs/architecture.md
!/docs/benchmarks.md
!/docs/comparison.md
!/docs/configuration.md
!/docs/experiments.md
!/docs/install.md
!/docs/roadmap.md
!/docs/server.md

# Internal: specs and agent tooling
/specs/
.claude/
graphify-out/
CLAUDE.local.md

# Internal working files, in any directory
NOTES.md
PLAN.md
BENCHMARKS.md
HANDOFF.md
MEMORY.md
next-session*.md

# Internal working folders, at the root only
/bench/
/results/
/memory/

# Environment
.env

# Editors / OS
*.swp
.DS_Store

# `nohup bash scripts/<sweep>.sh &` drops this here, and a sweep that greps
# its own tree for provenance would otherwise report itself as dirty.
/nohup.out

# Python bytecode from scripts/
__pycache__/
